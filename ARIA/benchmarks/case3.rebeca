reactiveclass Starter(4) {
	knownrebecs { Worker worker1; Worker worker2; Worker worker3; }
	statevars { }
	Starter() {
		self.startWorkers();
	}
	msgsrv startWorkers() {
		worker1.begin();
		worker2.begin();
		worker3.begin();
	}
}

reactiveclass Controller(2) {
	knownrebecs { Worker worker1; Worker worker2; }
	statevars { }
	Controller() {
		self.fire();
	}
	msgsrv fire() {
		worker1.enable();
		worker2.enable();
	}
}

reactiveclass Worker(3) {
	knownrebecs { Cell cell; }
	statevars { byte id; byte progress; boolean active; }
	Worker(byte workerId) {
		id = workerId;
		progress = 0;
		active = false;
	}
	msgsrv enable() {
		active = true;
	}
	msgsrv begin() {
		progress = 1;
		self.step();
	}
	msgsrv step() {
		progress = 2;
		self.finish();
	}
	msgsrv finish() {
		progress = 3;
		if (active) {
			cell.store(id);
		}
	}
}

reactiveclass Cell(5) {
	knownrebecs { }
	statevars { int value; }
	Cell() {
		value = 0;
		self.keepAlive();
	}
	msgsrv store(byte newValue) {
		value = newValue;
	}
	msgsrv keepAlive() {
		self.keepAlive();
	}
}

main {
	Cell       cell():();
	Worker     worker1(cell):(1);
	Worker     worker2(cell):(2);
	Worker     worker3(cell):(3);
	Starter    starter(worker1, worker2, worker3):();
	Controller ctrl(worker1, worker2):();
}