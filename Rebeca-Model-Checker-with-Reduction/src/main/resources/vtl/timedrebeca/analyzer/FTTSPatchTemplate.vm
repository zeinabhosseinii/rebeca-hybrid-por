#if ($fileGeneratorProperties.isReduction())
bool TimedModelChecker::areActiveActionsSafe(byte* state, int r, int messageId) {
#if ($fileGeneratorProperties.isAriaReduction())
    // Conservative C1 fallback: include future message servers, not just queue heads.
    static bool sdiPairs[REBEC_COUNT][$maxMsgIdPlusOne][REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($rowI in $sdiMatrix)
        { #foreach($rowIM in $rowI){ #foreach($rowJ in $rowIM){ #foreach($val in $rowJ)$val#if(!$foreach.last), #end#end }#if(!$foreach.last), #end#end }#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
    };
    // Certificate is valid only after constructors, with original actor identities.
#ifndef POR_DISABLE_QUIESCENCE
    static const bool neverSent[REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($row in $neverSentAgain)
        { #foreach($val in $row)$val#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
    };
#endif
    int rMsgId = messageId > 0 ? messageId : (unsigned char)rebecs[r]->messageQueue[0];
    for (int j = 0; j < REBEC_COUNT; j++) {
        if (j == r) continue;
        for (int jMsgId = 1; jMsgId < $maxMsgIdPlusOne; jMsgId++)
            if (sdiPairs[r][rMsgId][j][jMsgId]) {
#ifndef POR_DISABLE_QUIESCENCE
                if (${isolatedLocalAllowed} && neverSent[j][jMsgId]) {
                    bool pending = false;
                    for (int slot = 0; slot < rebecs[j]->maxQueueLength; slot++)
                        if ((unsigned char)rebecs[j]->messageQueue[slot] == jMsgId) pending = true;
                    if (!pending) {
#ifdef POR_DIAGNOSTICS
                        cerr << "POR_QUIESCENT_SKIP state=" << current.state->stateID
                             << " actor=" << rebecs[r]->getName() << " msg=" << rMsgId
                             << " blocker=" << rebecs[j]->getName() << " blockerMsg=" << jMsgId << endl;
#endif
                        continue;
                    }
                }
#endif
#ifdef POR_DIAGNOSTICS
                cerr << "POR_BLOCK state=" << current.state->stateID
                     << " actor=" << rebecs[r]->getName() << " msg=" << rMsgId
                     << " blocker=" << rebecs[j]->getName() << " blockerMsg=" << jMsgId
                     << " blockerHead=" << (int)(unsigned char)rebecs[j]->messageQueue[0]
                     << " scope=global_all_methods" << endl;
#endif
                return false;
            }
    }
    return true;
#else
	static bool safeActions[REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($row in $safeActionsTable)
		{ #foreach($val in $row)$val#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
	};
	int msg = messageId > 0 ? messageId : (unsigned char)rebecs[r]->messageQueue[0];
    return safeActions[r][msg];
#end
}

int TimedModelChecker::chooseIsolatedLocalAlternative(int r, TIME_TYPE execTime, int firstAlternative) {
    if (firstAlternative < 0) return -1;
    if (!$isolatedLocalAllowed) return -1;
    static const bool localSafe[REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($row in $isolatedLocalSafe)
        { #foreach($value in $row)$value#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
    };
    static const bool localIndependent[REBEC_COUNT][$maxMsgIdPlusOne][$maxMsgIdPlusOne] = {
#foreach($actor in $isolatedLocalIndependent)
        { #foreach($row in $actor){ #foreach($value in $row)$value#if(!$foreach.last), #end#end }#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
    };
    // All possible future work must already be in this actor's local queue.
    for (int j = 0; j < REBEC_COUNT; j++)
        if (j != r && rebecs[j]->messageQueue[0]) return -1;
    if (rebecs[r]->maxParamLength != 0 || execTime != current.currentTime ||
        rebecs[r]->getNow() != execTime) return -1;
    int count = 0;
    while (count < rebecs[r]->maxQueueLength && rebecs[r]->messageQueue[count]) {
        int id = (unsigned char)rebecs[r]->messageQueue[count];
        if (id <= 0 || id >= $maxMsgIdPlusOne || !localSafe[r][id] ||
            rebecs[r]->executionTime[count] != execTime ||
            rebecs[r]->deadline[count] != MAX_TIME) return -1;
        count++;
    }
    // Equal time/priority alternatives only; no postponed work is hidden.
    if (count < 2 || getNumberOfAlternatives(r, execTime) != count) return -1;
    for (int k = firstAlternative; k < count; k++) {
        int chosen = (unsigned char)rebecs[r]->messageQueue[k];
        bool independent = true;
        for (int other = 0; other < count; other++) {
            if (other == k) continue;
            int id = (unsigned char)rebecs[r]->messageQueue[other];
            // The chosen occurrence is unique; identical-method occurrences
            // retain the ordinary all-alternatives path.
            if (id == chosen || !localIndependent[r][chosen][id]) independent = false;
        }
        if (independent) {
#ifdef POR_DIAGNOSTICS
            cerr << "POR_LOCAL_ACTION state=" << current.state->stateID
                 << " actor=" << rebecs[r]->getName() << " alternative=" << k << endl;
#endif
            return k;
        }
    }
    return -1;
}

int TimedModelChecker::choosePassiveSendAlternative(int r, TIME_TYPE execTime, int firstAlternative) {
    if (firstAlternative < 0) return -1;
    if (!$isolatedLocalAllowed) return -1;
    static const bool pSafe[REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($row in $passiveSendSafe)
        { #foreach($value in $row)$value#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
    };
    static const bool pPassive[REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($row in $passiveSendPassive)
        { #foreach($value in $row)$value#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
    };
    static const int pTarget[REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($row in $passiveSendTargetActor)
        { #foreach($value in $row)$value#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
    };
    static const int pMessage[REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($row in $passiveSendTargetMessage)
        { #foreach($value in $row)$value#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
    };
    static const bool pIndependent[REBEC_COUNT][$maxMsgIdPlusOne][$maxMsgIdPlusOne] = {
#foreach($actor in $passiveSendIndependent)
        { #foreach($row in $actor){ #foreach($value in $row)$value#if(!$foreach.last), #end#end }#if(!$foreach.last), #end#end }#if(!$foreach.last),#end

#end
    };
    if (execTime != current.currentTime || rebecs[r]->getNow() != execTime ||
        rebecs[r]->maxParamLength != 0) return -1;
    int head = (unsigned char)rebecs[r]->messageQueue[0];
    if (head <= 0 || head >= $maxMsgIdPlusOne) return -1;
    int priority = rebecs[r]->messagePriorities[head];
    int length[REBEC_COUNT] = {0};
    int pendingSends[REBEC_COUNT] = {0};
    for (int j = 0; j < REBEC_COUNT; j++) {
        if (rebecs[j]->getPriority() != rebecs[r]->getPriority()) return -1;
        while (length[j] < rebecs[j]->maxQueueLength && rebecs[j]->messageQueue[length[j]]) {
            int k = length[j];
            int id = (unsigned char)rebecs[j]->messageQueue[k];
            if (id <= 0 || id >= $maxMsgIdPlusOne ||
                (j == r ? !pSafe[j][id] : !pPassive[j][id]) ||
                rebecs[j]->maxParamLength != 0 || rebecs[j]->getNow() != execTime ||
                rebecs[j]->executionTime[k] != execTime || rebecs[j]->deadline[k] != MAX_TIME ||
                rebecs[j]->messagePriorities[id] != priority) return -1;
            length[j]++;
        }
        if (length[j] >= rebecs[j]->maxQueueLength) return -1;
    }
    if (length[r] < 2 || getNumberOfAlternatives(r, execTime) != length[r]) return -1;
    for (int k = 0; k < length[r]; k++) {
        int id = (unsigned char)rebecs[r]->messageQueue[k];
        int target = pTarget[r][id], method = pMessage[r][id];
        if (target < 0) { if (method >= 0) return -1; continue; }
        if (target >= REBEC_COUNT || target == r || method <= 0 || method >= $maxMsgIdPlusOne ||
            !pPassive[target][method] || rebecs[target]->maxParamLength != 0 ||
            rebecs[target]->getNow() != execTime ||
            rebecs[target]->messagePriorities[method] != priority) return -1;
        pendingSends[target]++;
    }
    // Bound all enqueues before any sink is scheduled; keep an empty terminator slot.
    for (int j = 0; j < REBEC_COUNT; j++)
        if (pendingSends[j] > 0 && length[j] + pendingSends[j] >= rebecs[j]->maxQueueLength) return -1;
    for (int k = firstAlternative; k < length[r]; k++) {
        int id = (unsigned char)rebecs[r]->messageQueue[k];
        int target = pTarget[r][id];
        if (target >= 0 && length[target] != 0) continue;
        bool independent = true;
        for (int b = 0; b < length[r]; b++) {
            if (b == k) continue;
            int other = (unsigned char)rebecs[r]->messageQueue[b];
            if (id == other || !pIndependent[r][id][other]) independent = false;
        }
        if (independent) {
#ifdef POR_DIAGNOSTICS
            cerr << "POR_PASSIVE_SEND_ACTION state=" << current.state->stateID
                 << " actor=" << rebecs[r]->getName() << " alternative=" << k << endl;
#endif
            return k;
        }
    }
    return -1;
}

#if($ariaPropertyFilterEnabled && $tokenQueueCertified)
bool TimedModelChecker::isNullaryQueueCandidateSafe(int r, TIME_TYPE execTime) {
    static const bool known[REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($row in $tokenQueueKnown)
        {#foreach($value in $row)$value#if(!$foreach.last),#end#end}#if(!$foreach.last),#end
#end
    };
    static const bool sends[REBEC_COUNT][$maxMsgIdPlusOne][REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($actor in $tokenQueueSends)
        {#foreach($method in $actor){#foreach($target in $method){#foreach($value in $target)$value#if(!$foreach.last),#end#end}#if(!$foreach.last),#end#end}#if(!$foreach.last),#end#end}#if(!$foreach.last),#end
#end
    };
    static const bool conflicts[REBEC_COUNT][$maxMsgIdPlusOne][REBEC_COUNT][$maxMsgIdPlusOne] = {
#foreach($actor in $tokenQueueConflicts)
        {#foreach($method in $actor){#foreach($target in $method){#foreach($value in $target)$value#if(!$foreach.last),#end#end}#if(!$foreach.last),#end#end}#if(!$foreach.last),#end#end}#if(!$foreach.last),#end
#end
    };
    bool selected[$maxMsgIdPlusOne] = {};
    for (int k = 0; k < getNumberOfAlternatives(r, execTime); ++k) {
        int id = (unsigned char)rebecs[r]->messageQueue[k];
        if (id <= 0 || id >= $maxMsgIdPlusOne || !known[r][id]) return false;
        selected[id] = true;
    }
    bool seen[REBEC_COUNT][$maxMsgIdPlusOne] = {};
    std::vector<int> pending;
    for (int j = 0; j < REBEC_COUNT; ++j)
        for (int slot = 0; slot < rebecs[j]->maxQueueLength && rebecs[j]->messageQueue[slot]; ++slot) {
            int id = (unsigned char)rebecs[j]->messageQueue[slot];
            if (id <= 0 || id >= $maxMsgIdPlusOne || !known[j][id]) return false;
            if (j != r || !selected[id]) pending.push_back(j * $maxMsgIdPlusOne + id);
        }
    while (!pending.empty()) {
        int key = pending.back(); pending.pop_back();
        int j = key / $maxMsgIdPlusOne, id = key % $maxMsgIdPlusOne;
        if (seen[j][id]) continue;
        seen[j][id] = true;
        for (int chosen = 1; chosen < $maxMsgIdPlusOne; ++chosen)
            if (selected[chosen] && conflicts[r][chosen][j][id]) {
#ifdef POR_DIAGNOSTICS
                cerr << "POR_QUEUE_BLOCK state=" << current.state->stateID << " actor=" << rebecs[r]->getName()
                     << " selectedMsg=" << chosen << " futureActor=" << rebecs[j]->getName() << " futureMsg=" << id << endl;
#endif
                return false;
            }
        for (int target = 0; target < REBEC_COUNT; ++target)
            for (int method = 1; method < $maxMsgIdPlusOne; ++method)
                if (sends[j][id][target][method] && (target != r || !selected[method]))
                    pending.push_back(target * $maxMsgIdPlusOne + method);
    }
    return true;
}
#end
std::vector<TimedModelChecker::PorCandidate> TimedModelChecker::collectPorCandidates(int r, TIME_TYPE execTime) {
    std::vector<PorCandidate> choices;
    int cursor = 0;
    while (true) {
        int k = chooseIsolatedLocalAlternative(r, execTime, cursor);
        if (k < 0) break;
        PorCandidate c = {r, (unsigned char)rebecs[r]->messageQueue[k], "isolated_local", {k}};
        choices.push_back(c);
        cursor = k + 1;
    }
    if (!choices.empty()) return choices;
    cursor = 0;
    while (true) {
        int k = choosePassiveSendAlternative(r, execTime, cursor);
        if (k < 0) break;
        PorCandidate c = {r, (unsigned char)rebecs[r]->messageQueue[k], "passive_send", {k}};
        choices.push_back(c);
        cursor = k + 1;
    }
    if (!choices.empty()) return choices;
    // Global safety alone does NOT justify splitting distinct methods of one actor.
#if($ariaPropertyFilterEnabled && $tokenQueueCertified)
    if (!isNullaryQueueCandidateSafe(r, execTime)) return choices;
#else
    if (!areAllActiveAlternativesSafe(r, execTime)) return choices;
#end
    int count = getNumberOfAlternatives(r, execTime);
    int id = (unsigned char)rebecs[r]->messageQueue[0];
#if($ariaPropertyFilterEnabled && $tokenQueueCertified)
    PorCandidate c = {r, id, "nullary_queue_closure", {}};
#else
    PorCandidate c = {r, id, "global_dependency_check", {}};
#end
    for (int k = 0; k < count; k++) {
        c.alternatives.push_back(k);
        if ((unsigned char)rebecs[r]->messageQueue[k] != id) c.messageId = 0;
    }
    if (c.messageId == 0) c.proof = "unsplit_actor_union";
    choices.push_back(c);
    return choices;
}

bool TimedModelChecker::isPorCandidateFull(const PorCandidate& candidate, TIME_TYPE currentTime, int highestPriority) {
    int r = candidate.actor;
    TIME_TYPE execTime = max(rebecs[r]->getNow(), rebecs[r]->executionTime[0]);
    int count = getNumberOfAlternatives(r, execTime);
    if ((int)candidate.alternatives.size() != count) return false;
    for (int k = 0; k < count; k++) if (candidate.alternatives[k] != k) return false;
    for (int j = 0; j < REBEC_COUNT; j++) {
        if (j == r || !rebecs[j]->messageQueue[0] || rebecs[j]->getPriority() != highestPriority) continue;
        if (max(rebecs[j]->getNow(), rebecs[j]->executionTime[0]) <= currentTime) return false;
    }
    return true;
}

bool TimedModelChecker::isPorSuccessorAllowed(bool candidateIsFull) {
#if($ariaPropertyFilterEnabled)
    // Every accepted partial edge must discover a fresh state: partial-only cycles are impossible.
    return candidateIsFull || (_porResult & NEW_STATE);
#else
#ifdef POR_LEGACY_PROVISO
    return (_porResult & NEW_STATE) || _porResultState->openCount > 0;
\#else
    if (candidateIsFull || (_porResult & NEW_STATE) || _porResultState->openCount > 0) return true;
    // Only certified zero-time, single-bundle models may use node-wide barriers.
    return ${cycleBarriersAllowed} && _porResultState->porFullExpanded;
#endif
#end
}

bool TimedModelChecker::areAllActiveAlternativesSafe(int r, TIME_TYPE execTime) {
    int alternatives = getNumberOfAlternatives(r, execTime);
    for (int k = 0; k < alternatives; k++) {
        int messageId = (unsigned char)rebecs[r]->messageQueue[k];
        if (!areActiveActionsSafe(NULL, r, messageId)) return false;
    }
    return true;
}

bool TimedModelChecker::isEquivalentQueueAlternative(int r, int alternative) {
    // Moving either of two ADJACENT identical queue entries to the head
    // produces exactly the same pre-execution configuration. Nonadjacent
    // equal entries cannot be merged: their intervening queue order can differ.
    if (alternative <= 0 || alternative >= rebecs[r]->maxQueueLength) return false;
    int previous = alternative - 1;
    if (!rebecs[r]->messageQueue[alternative] ||
        rebecs[r]->messageQueue[alternative] != rebecs[r]->messageQueue[previous] ||
        rebecs[r]->senderQueue[alternative] != rebecs[r]->senderQueue[previous] ||
        rebecs[r]->executionTime[alternative] != rebecs[r]->executionTime[previous] ||
        rebecs[r]->deadline[alternative] != rebecs[r]->deadline[previous]) return false;
    if (rebecs[r]->maxParamLength > 0) {
        if (!rebecs[r]->paramQueue[alternative] || !rebecs[r]->paramQueue[previous]) return false;
        for (int b = 0; b < rebecs[r]->maxParamLength; b++)
            if (rebecs[r]->paramQueue[alternative][b] != rebecs[r]->paramQueue[previous][b]) return false;
    }
#ifdef POR_DIAGNOSTICS
    cerr << "POR_EQUIVALENT_SKIP state=" << current.state->stateID
         << " actor=" << rebecs[r]->getName() << " alternative=" << alternative << endl;
#endif
    return true;
}

#end

void TimedModelChecker::printCounterExampleTransition(TimedBFSState* parent, TimedBFSState* child) {

	OpenBorderNode parentNode, childNode;
	
	childNode.state = child;
	childNode.stateActiveBundleNumber = 0;
	
	parentNode.state = parent;
	parentNode.stateActiveBundleNumber = 0;
	
	int rebecId = child->parents.front().executedRebecIndex;
	string label = "";
	label = rebecs[rebecId]->activeAction();
	string sender = rebecs[rebecs[rebecId]->senderQueue[0]]->getName();
	exportTransition(parentNode, childNode, sender, rebecs[rebecId]->getName(), label, rebecs[rebecId]->getNow(), 0, out);
}
